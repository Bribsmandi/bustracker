[Unit]
Description=Bus tracker relay (plain HTTP from ESP32 -> MQTT)
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=bustracker
Group=bustracker
Environment=RELAY_PORT=8081
Environment=RELAY_CONF=/etc/bustracker-relay
Environment=RELAY_STATE=/var/lib/bustracker-relay
ExecStart=/usr/bin/python3 /opt/bustracker-relay/relay.py
Restart=always
RestartSec=3

# Hardening. This box also runs the MQTT broker and other services; the relay
# must not be able to reach or disturb them beyond publishing to the broker.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/bustracker-relay
StateDirectory=bustracker-relay

[Install]
WantedBy=multi-user.target
