# /etc/bustracker/server.env   (chmod 600)
#
# The defaults below point at the public broker and need no credentials, so
# this file usually needs no editing at all.

BUS_DATA_DIR=/opt/bustracker/data
BUS_DB_PATH=/var/lib/bustracker/bus.db

# Nothing in this system can accept an inbound connection -- the buses are on
# cellular NAT and this Pi is on a phone hotspot -- so everything dials out to
# a public broker instead.
BUS_MQTT_HOST=broker.emqx.io
BUS_MQTT_PORT=1883
BUS_MQTT_USERNAME=
BUS_MQTT_PASSWORD=

# Must match the buses and the app exactly. Unguessable on purpose: this is a
# shared public broker and a generic prefix collides with other people.
BUS_TOPIC_ROOT=cbt7f3c9e21b

# Per-device HMAC secrets, in the relay's devices.json format. Anyone can
# publish to a public broker, so an unsigned fix is not acted on.
BUS_SECRETS=/etc/bustracker/devices.json
BUS_REQUIRE_SIGNATURE=1

BUS_TZ=Asia/Kolkata

# Push notifications. Leave disabled until an FCM service account is in place.
BUS_PUSH_ENABLED=0
BUS_FCM_PROJECT_ID=
BUS_FCM_CREDENTIALS=/etc/bustracker/fcm-service-account.json
