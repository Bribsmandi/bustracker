# /etc/bustracker/server.env  (chmod 600, root-owned: it holds the broker password)

BUS_DATA_DIR=/opt/bustracker/data
BUS_DB_PATH=/var/lib/bustracker/bus.db

BUS_MQTT_HOST=127.0.0.1
BUS_MQTT_PORT=1883
BUS_MQTT_USERNAME=processor
BUS_MQTT_PASSWORD=change-me

BUS_TZ=Asia/Kolkata

# Push notifications. Leave disabled until the FCM service account is in place.
BUS_PUSH_ENABLED=0
BUS_FCM_PROJECT_ID=
BUS_FCM_CREDENTIALS=/etc/bustracker/fcm-service-account.json

# Only needed for the plan-B HTTPS ingest fallback.
BUS_INGEST_TOKENS=/etc/bustracker/ingest_tokens.json
